    { "source": "/fr/privacy", "destination": "/_prerender/fr/privacy.html" },
    { "source": "/fr/terms", "destination": "/_prerender/fr/terms.html" },
    { "source": "/zh-TW/:path*", "destination": "/api/localized-not-found?locale=zh-TW" },
    { "source": "/zh-CN/:path*", "destination": "/api/localized-not-found?locale=zh-CN" },
    { "source": "/en/:path*", "destination": "/api/localized-not-found?locale=en" },
    { "source": "/ja/:path*", "destination": "/api/localized-not-found?locale=ja" },
    { "source": "/ko/:path*", "destination": "/api/localized-not-found?locale=ko" },
    { "source": "/es/:path*", "destination": "/api/localized-not-found?locale=es" },
    { "source": "/pt-BR/:path*", "destination": "/api/localized-not-found?locale=pt-BR" },
    { "source": "/fr/:path*", "destination": "/api/localized-not-found?locale=fr" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    }
  ]
}
